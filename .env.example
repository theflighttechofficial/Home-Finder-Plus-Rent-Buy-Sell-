# Port the server listens on
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/userDB

# Secret used to sign login sessions. REQUIRED in production — use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to "production" when deploying (enables secure cookies, caching)
NODE_ENV=development

# Insert demo listings and accounts when the database is empty (true/false)
SEED_ON_START=true

# Where uploaded photos are stored (defaults to ./uploads)
# UPLOAD_DIR=
